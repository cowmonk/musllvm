set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR @ARCH@)
get_filename_component(MUSLLVM_HOME "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(CMAKE_SYSROOT "${MUSLLVM_HOME}/sysroot")
if(DEFINED ENV{MUSLLVM_SYSROOT} AND NOT "$ENV{MUSLLVM_SYSROOT}" STREQUAL "")
  set(CMAKE_SYSROOT "$ENV{MUSLLVM_SYSROOT}")
endif()
set(CMAKE_C_COMPILER "${MUSLLVM_HOME}/bin/@TARGET@-cc")
set(CMAKE_CXX_COMPILER "${MUSLLVM_HOME}/bin/@TARGET@-c++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${MUSLLVM_HOME}/bin/@TARGET@-ar")
set(CMAKE_RANLIB "${MUSLLVM_HOME}/bin/@TARGET@-ranlib")
set(CMAKE_STRIP "${MUSLLVM_HOME}/bin/@TARGET@-strip")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
